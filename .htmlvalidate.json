{
  "extends": [
    "html-validate:recommended"
  ],
  "rules": {
    "no-inline-style": "off",
    "no-trailing-whitespace": "off",
    "void-style": "off",
    "long-title": "off",
    "attribute-boolean-style": "off",
    "no-redundant-role": "off",
    "prefer-native-element": "off",
    "no-raw-characters": "off",
    "element-required-attributes": "error",
    "valid-id": [
      "error",
      {
        "relaxed": true
      }
    ],
    "doctype-style": "off",
    "no-autoplay": "off"
  }
}